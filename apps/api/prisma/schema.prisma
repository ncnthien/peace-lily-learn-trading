generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candle {
  id        Int    @id @default(autoincrement())
  symbol    String
  interval  String
  openTime  BigInt
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float

  @@unique([symbol, interval, openTime])
  @@index([symbol, interval, openTime(sort: Desc)])
}

model SignalEvaluation {
  id         Int      @id @default(autoincrement())
  symbol     String
  interval   String
  signal     String
  price      Float
  indicators Json
  reason     String
  createdAt  DateTime @default(now())

  @@index([symbol, interval, createdAt(sort: Desc)])
}

model PositionBox {
  id            String   @id @default(uuid())
  symbol        String
  interval      String
  side          String
  entryOpenTime BigInt
  bars          Int
  entryPrice    Float
  stopPrice     Float
  tpPrice       Float
  createdAt     DateTime @default(now())

  @@index([symbol, interval])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ============================================================
// NCN-5: Core domain models (see @workspace/shared for the
// TS contract). String columns mirror the contract's string
// unions; AutomationItem configs are validated JSON.
// ============================================================

model Account {
  id        String           @id @default(uuid())
  /// Display name (required at the API layer)
  name      String
  type      String // 'real' | 'demo'
  balance   Float            @default(0)
  status    String           @default("active") // 'active' | 'disabled'
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  trades         Trade[]
  positions      Position[]
  automationItems AutomationItem[]
}

model Trade {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  symbol    String
  side      String // 'buy' | 'sell'
  price     Float
  qty       Float
  /// Fees paid on this fill, in the same quote currency as `price`.
  /// Nullable so legacy rows keep computing PnL as if `fee = 0`. Used by
  /// the realized-PnL FIFO matcher (NCN-20): buys add `fee` to cost basis,
  /// sells subtract `fee` from proceeds, allocated proportionally when a
  /// sell only partially closes a buy lot.
  fee       Float?
  timestamp DateTime
  /// Set when generated by an AutomationItem; absent trades are manual.
  /// Kept nullable so the append-only ledger survives automation item
  /// deletion (FK resolves to null)
  automationItemId String?
  automationItem    AutomationItem? @relation(fields: [automationItemId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([accountId, timestamp(sort: Desc)])
  @@index([symbol, timestamp(sort: Desc)])
}

/// One open position per account + symbol (contract: per account+symbol state).
/// unrealizedPnl is derived at read time (needs a live mark price) — not stored.
model Position {
  id            String   @id @default(uuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  symbol        String
  side          String // 'buy' | 'sell'
  qty           Float
  avgEntryPrice Float
  openedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([accountId, symbol])
}

model AutomationItem {
  id         String   @id @default(uuid())
  /// Owning account (NCN-12). Required at the API layer.
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String
  input      Json // AutomationInput (discriminated union, see shared contract)
  condition  Json // ConditionNode tree — single root; leaf + composite (see shared contract)
  action     Json // AutomationAction
  output     Json // AutomationOutput
  status     String   @default("enabled") // 'enabled' | 'disabled' | 'paused'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  trades     Trade[]
}

model SRLine {
  id        String   @id @default(uuid())
  symbol    String
  interval  String
  kind      String
  price     Float
  createdAt DateTime @default(now())

  @@index([symbol, interval])
}
